# Copier en .env.local (jamais dans Git) et renseigner les valeurs depuis le tableau de bord Supabase
# Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé service_role : SECRÈTE, uniquement côté serveur (ne jamais préfixer par NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Anti-bot Cloudflare Turnstile (affiché après le clic sur « Payer »). Dashboard Cloudflare → Turnstile.
# Sans clé, le développement utilise les clés de test publiques de Cloudflare ; la production exige ces clés.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Paiement Kkiapay. Tableau de bord Kkiapay → Clés API. KKIAPAY_SANDBOX=false uniquement en production.
# KKIAPAY_WEBHOOK_SECRET = le « hash secret » saisi en créant le webhook (URL : https://<domaine>/api/billetterie/kkiapay-webhook).
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true
KKIAPAY_WEBHOOK_SECRET=

# E-mail du billet (QR codes) via Resend : https://resend.com → API Keys, et vérifier le domaine lateufelectronic.com.
# EMAIL_FROM : expéditeur sur le domaine vérifié, ex. LA TEUF <billets@lateufelectronic.com>. En développement, sans valeur,
# l'expéditeur de test de Resend est utilisé (il n'envoie qu'à l'adresse du compte Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Secret de signature des QR codes : longue chaîne aléatoire (ex. `openssl rand -base64 32`), à ne jamais changer en cours de vente.
TICKET_SIGNING_SECRET=
# URL publique du site (liens « Télécharger » des e-mails). En développement : http://localhost:3000 (ne marche que sur cette machine).
SITE_URL=
